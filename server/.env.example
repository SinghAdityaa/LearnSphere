PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/learnsphere
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=

ENABLE_DEMO_LOGIN=true
# For production set ENABLE_DEMO_LOGIN=false and NODE_ENV=production.
# CLIENT_URL must contain exactly the allowed frontend origins (comma separated).
# Use HTTPS and a strong random JWT_SECRET of at least 32 characters.
